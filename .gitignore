# corpus — PDFs stay local (licence + size), hashes are committed in CORPUS.md
corpus/

# papers — third-party PDFs, kept local (reading reference; never shipped)
papers/

# models / indexes / caches
models/
.cache/
artifacts/

# parse output — derived data (node `parse`): regenerate, never commit
parsed/

# local playground — experiments only, never part of the pipeline
scratch/
.ipynb_checkpoints/

# working diagrams — scratch aids, edited while a node is in progress
diagrams/

# python
.venv/
.venv-graphrag/  # GraphRAG cannot share an environment with docling (typer ranges are disjoint)
__pycache__/
*.py[cod]
.env

# os
.DS_Store

# qset drafts — carry source text (© OEM); only questions.jsonl is committed
qset/drafts.jsonl
qset/review.md
qset/critique.jsonl
qset/shortlist.jsonl

# benchmark answers — carry corpus-derived text (© OEM), same reason as the qset drafts.
# The aggregate artifacts ARE committed — numbers, never answer text: the judged table (§7.5),
# the head-to-head ladder, the router's input table, and the judge's pins. Everything else in
# results/ (the answer JSONLs, the judge's per-item scores) stays local.
results/*
!results/results.csv
!results/head_to_head.csv
!results/class_strategy.json
!results/judge_pins.json

# working documents and journals — local only, never published
AGENTS.md
PREPLAN.md
ROADMAP.md
sessions/
